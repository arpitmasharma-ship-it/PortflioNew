NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000

MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=portfolio_token

# Comma-separated origins allowed in production
CORS_ORIGINS=http://localhost:5173

# Initial admin is created once via POST /api/auth/setup
# Do not commit real credentials.

# Cloudinary Uploads (Get free account at https://cloudinary.com)
# Option A: Individual credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Option B: Single connection URL from Cloudinary Dashboard
# CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Portfolio <noreply@example.com>"
CONTACT_NOTIFY_EMAIL=

# Optional: used by sitemap/canonical URLs
PUBLIC_SITE_URL=http://localhost:5173
